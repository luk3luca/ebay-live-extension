{
  "manifest_version": 3,
  "name": "eBay Live Clean",
  "version": "2.0.0",
  "description": "Massimizza il video di eBay Live (verticale 9:16, senza crop) e sposta chat + oggetti in una colonna laterale. Header e sezioni inutili nascosti.",

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },

  "permissions": [
    "storage"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.ebay.it/ebaylive/*"],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "content/page.css",
        "content/player-frame.css"
      ],
      "js": [
        "content/inject.js"
      ]
    },
    {
      "matches": ["*://*.ebaystatic.com/*"],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "content/video-frame.css"
      ],
      "js": [
        "content/inject.js"
      ]
    }
  ],

  "action": {
    "default_title": "eBay Live Clean",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  }
}
