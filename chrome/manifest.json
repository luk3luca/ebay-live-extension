{
  "manifest_version": 3,
  "name": "eBay Live Clean",
  "version": "1.0.0",
  "description": "Maximizes the eBay Live video (vertical 9:16, no cropping) and moves chat + items to a side column. Headers and QR hidden; seller info and events stay in place.",

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },

  "permissions": [
    "storage"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.ebay.it/ebaylive/*"],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "content/page.css",
        "content/player-frame.css"
      ],
      "js": [
        "content/inject.js"
      ]
    },
    {
      "matches": ["*://*.ebaystatic.com/*"],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "content/video-frame.css"
      ],
      "js": [
        "content/inject.js"
      ]
    }
  ],

  "action": {
    "default_title": "eBay Live Clean",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  }
}
